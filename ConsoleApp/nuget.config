<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />

    <add key="artifactory.playticorp.com/nuget-bb" value="https://artifactory.playticorp.com/artifactory/api/nuget/v3/nuget-bb" protocolVersion="3" />
    <add key="artifactory.playticorp.com/nuget-release" value="https://artifactory.playticorp.com/artifactory/api/nuget/v3/nuget-release" protocolVersion="3" />
    <add key="artifactory.playticorp.com/nuget" value="https://artifactory.playticorp.com/artifactory/api/nuget/v3/nuget" protocolVersion="3" />
    <add key="artifactory.playticorp.com/monosyne-infra" value="https://artifactory.playticorp.com/artifactory/api/nuget/v3/monosyne-infra" protocolVersion="3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="artifactory.playticorp.com/nuget">
      <package pattern="*" />
    </packageSource>

    <packageSource key="artifactory.playticorp.com/nuget-bb">
      <package pattern="Playtika.BB.Ioc" />
      <package pattern="Playtika.BB.Ioc.Autofac" />
      <package pattern="Autofac" />
    </packageSource>

  </packageSourceMapping>
</configuration>
